# ─── Sanity CMS ──────────────────────────────────────
# Find these at: https://sanity.io/manage → your project
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
# Create a token at: Sanity Manage → API → Tokens (Editor role)
SANITY_API_TOKEN=your_sanity_token_here

# ─── Newsletter (Mailchimp) ───────────────────────────
# Get at: mailchimp.com → Account → Extras → API Keys
# The DC (datacenter) is the last part of your API key e.g. "us21"
MAILCHIMP_API_KEY=your_api_key-us21
# Get at: mailchimp.com → Audience → Settings → Audience name and defaults → Audience ID
MAILCHIMP_LIST_ID=your_list_id_here

# ─── Google Analytics ────────────────────────────────
# Already hardcoded in layout.tsx as G-ZJN2EDM4HL
# If you want to use an env var instead:
# NEXT_PUBLIC_GA_ID=G-ZJN2EDM4HL

# ─── Site URL ────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://upnaad.com
